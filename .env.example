# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Local development                                                       ║
# ║                                                                          ║
# ║  Choose ONE option: standard PostgreSQL or Neon.                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# LAN / remote dev: set this machine's hostname so the dev server accepts cross-origin requests
# NEXT_DEV_ALLOWED_ORIGINS=dev-machine.local

# Option A: Standard PostgreSQL (postgres.js TCP driver)
# DATABASE_READONLY_URL=postgresql://postgres:postgres@localhost:5432/postgres
# DATABASE_DRIVER=postgres
# DATABASE_SSL=false

# Option B: Neon (serverless HTTP driver)
# DATABASE_READONLY_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/database
# DATABASE_DRIVER=neon
# DATABASE_SSL=true

# GitHub PAT — used for framework releases, star counts, unofficial-run artifact reads,
# and (optional, raises the rate limit) the CollectiveX committed-results ingest
# Create at: https://github.com/settings/personal-access-tokens
# GITHUB_TOKEN=
# Extra benchmark source repos (owner/repo, comma-separated) searched after
# SemiAnalysisAI/InferenceX; GITHUB_TOKEN must read Actions artifacts in each.
# See docs/deployment-configuration.md.
# INFERENCEX_SOURCE_REPOS=

# Optional local artifact preview: set in packages/app/.env.development.local.
# Read only in development on loopback hosts; production never uses these files.
# Directory contains <runId>.json with { run, benchmarks, evaluations }.
# INFERENCEX_LOCAL_ARTIFACT_DIR=/absolute/path/to/local-artifacts

# CollectiveX database (separate Neon instance), filled from InferenceX's committed
# collectivex/results/ by POST /api/v1/collectivex/ingest or admin:db:ingest:collectivex.
# The app routes read and write through DATABASE_COLLECTIVEX_WRITE_URL; they do not read
# DATABASE_COLLECTIVEX_READONLY_URL.
# DATABASE_COLLECTIVEX_READONLY_URL=
# DATABASE_COLLECTIVEX_WRITE_URL=

# Agentic Workload Explorer: frozen, anonymized ProxyTrace snapshot (separate Neon
# read replica). Read-only; the explorer never writes. Unset = explorer API returns 500.
# DATABASE_PROXYTRACE_READONLY_URL=

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Production deployment (Vercel)                                          ║
# ║                                                                          ║
# ║  Set these in the Vercel dashboard. DATABASE_READONLY_URL is required,   ║
# ║  and GITHUB_TOKEN for GitHub-backed features. Cache, Blob, and PostHog   ║
# ║  variables are optional; their features turn off when unset. See         ║
# ║  docs/deployment-configuration.md.                                       ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# DATABASE_READONLY_URL=
# DATABASE_DRIVER=neon
# DATABASE_SSL=true
# CACHE_NAMESPACE=
# BLOB_CACHE_PREFIX=
# BLOB_READ_WRITE_TOKEN=
# GITHUB_TOKEN=

# PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# Set to 0 to disable server-side CLI/skill request counts; Vercel production/preview only.
# INFERENCEX_REQUEST_ANALYTICS=1

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  Secrets and database administration (DO NOT SHARE)                      ║
# ║                                                                          ║
# ║  DB scripts (migrate, ingest, reset, etc) read these. The app also reads ║
# ║  INVALIDATE_SECRET, FEEDBACK_SECRET, and COLLECTIVEX_ADMIN_SECRET (and   ║
# ║  DATABASE_WRITE_URL for feedback) at runtime; set them in Vercel too.    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# DATABASE_WRITE_URL=
# INVALIDATE_SECRET=
# Optional Vercel Deployment Protection bypass for cache scripts and verifiers.
# VERCEL_PROTECTION_BYPASS_SECRET=
# Required origin for warm-video-results, and for verify-power-publication
# without an origin argument.
# INFERENCEX_APP_URL=
# Required by ingest, backfill, and artifact-preparation scripts when no
# argument or run URL names the repository.
# INGEST_REPO=
# FEEDBACK_SECRET=
# Bearer token for POST /api/v1/collectivex/ingest (the InferenceX ingest workflow).
# COLLECTIVEX_ADMIN_SECRET=

# OperatorX durable raw-artifact cache (primary, write-capable connection).
# Apply admin:db:migrate:operatorx before enabling the hidden OperatorX tab.
# DATABASE_OPERATORX_WRITE_URL=
# App read connection for /api/v1/operatorx/* (503 when unset).
# DATABASE_OPERATORX_READONLY_URL=
# Optional development-only preview of downloaded <runId>.json bundles, loopback only.
# OPERATORX_LOCAL_ARTIFACT_DIR=
