{
  "name": "@semianalysisai/inferencex-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./collectivex/*": "./src/collectivex/*.ts",
    "./connection": "./src/connection.ts",
    "./etl/*": "./src/etl/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./migrate": "./src/migrate.ts",
    "./queries/*": "./src/queries/*.ts",
    "./operatorx/*": "./src/operatorx/*.ts",
    "./power-series/*": "./src/power-series/*.ts",
    "./proxytrace/*": "./src/proxytrace/*.ts"
  },
  "scripts": {
    "db:prepare:ci": "bun src/prepare-ci-artifacts.ts",
    "db:ingest:ci": "bun src/ingest-ci-run.ts",
    "db:ingest:collectivex": "bun --env-file=../../.env src/ingest-collectivex.ts",
    "db:ingest:run": "bun --env-file=../../.env src/ingest-ci-run.ts --download",
    "db:ingest:gcs": "bun --env-file=../../.env src/ingest-gcs-backup.ts",
    "db:migrate": "bun --env-file=../../.env src/migrate.ts",
    "db:migrate:collectivex": "bun --env-file=../../.env src/migrate-collectivex.ts",
    "db:apply-overrides": "bun --env-file=../../.env src/apply-overrides.ts",
    "db:backfill-agentic-disagg-throughput": "bun --env-file=../../.env src/backfill-agentic-disagg-throughput.ts",
    "db:backfill-aggregate-stats": "bun --env-file=../../.env src/backfill-aggregate-stats.ts",
    "db:backfill-atom-kv-capacity": "bun --env-file=../../.env src/backfill-atom-kv-capacity.ts",
    "db:backfill-chart-series": "bun --env-file=../../.env src/backfill-chart-series.ts",
    "db:backfill-chart-series-summary": "bun --env-file=../../.env src/backfill-chart-series-summary.ts",
    "db:backfill-dataset-stats": "bun --env-file=../../.env src/backfill-dataset-stats.ts",
    "db:backfill-gpu-metrics": "bun --env-file=../../.env src/backfill-gpu-metrics.ts",
    "db:backfill-gpu-sample-blobs": "bun --env-file=../../.env src/backfill-gpu-sample-blobs.ts",
    "db:backfill-log-redaction": "bun --env-file=../../.env src/backfill-log-redaction.ts",
    "db:backfill-power-series": "bun --env-file=../../.env src/backfill-power-series.ts",
    "db:backfill-full-response-interactivity": "bun --env-file=../../.env src/backfill-full-response-interactivity.ts",
    "db:backfill-request-chart-data": "bun --env-file=../../.env src/backfill-request-chart-data.ts",
    "db:backfill-request-timeline": "bun --env-file=../../.env src/backfill-request-timeline.ts",
    "db:backfill-request-timeline-sha256": "bun --env-file=../../.env src/backfill-request-timeline-sha256.ts",
    "db:backfill-runtime-metadata": "bun --env-file=../../.env src/backfill-runtime-metadata.ts",
    "db:backfill-sequence-length-sketches": "bun --env-file=../../.env src/backfill-sequence-length-sketches.ts",
    "db:backfill-server-log-files": "bun --env-file=../../.env src/backfill-server-log-files.ts",
    "db:backfill-spec-algorithm": "bun --env-file=../../.env src/backfill-spec-algorithm.ts",
    "db:compact-server-logs": "bun --env-file=../../.env src/compact-server-logs.ts",
    "db:promote-to-public": "bun --env-file=../../.env src/sync-public-db.ts --to-public",
    "db:reset": "bun --env-file=../../.env src/reset-db.ts",
    "db:sync-public": "bun --env-file=../../.env src/sync-public-db.ts",
    "db:verify": "bun --env-file=../../.env src/verify-db.ts",
    "db:verify-gpu-sample-blobs": "bun --env-file=../../.env src/verify-gpu-sample-blobs.ts",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "db:migrate:operatorx": "bun --env-file=../../.env src/migrate-operatorx.ts",
    "db:ingest:operatorx": "bun --env-file=../../.env src/ingest-operatorx.ts",
    "db:ingest:operatorx:ci": "bun src/ingest-operatorx.ts",
    "db:backfill:operatorx-comparisons": "bun --env-file=../../.env src/backfill-operatorx-comparisons.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@noble/ciphers": "^2.4.0",
    "@semianalysisai/inferencex-constants": "workspace:*",
    "kysely": "^0.29.8",
    "kysely-neon": "^3.0.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "stream-chain": "^4.4.1",
    "stream-json": "^3.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/stream-json": "^1.7.8",
    "@vitest/coverage-v8": "^5.1.0",
    "adm-zip": "^0.6.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
